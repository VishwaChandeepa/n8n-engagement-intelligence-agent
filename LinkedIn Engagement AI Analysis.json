      "parameters": {
        "jsCode": "return $input.all().map(item => ({\n  json: {\n    post_text: item.json.post_text,\n    posted_at: item.json.posted_at,\n    likes: Number(item.json.likes || 0),\n    comments: Number(item.json.comments || 0),\n    shares: Number(item.json.shares || 0)\n  }\n}));"
